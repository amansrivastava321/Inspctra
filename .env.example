# Copy this file to ".env" in the project root and fill in the values you need:
#
#   cp .env.example .env
#
# ".env" is gitignored and is never committed. Keep real keys out of this example file.
# Variables already set in your shell take priority over this file.

# ── Cloud AI providers (optional) ─────────────────────────────────────────────
# Cloud models are used only when ALL THREE are set: a key below, ALLOW_CLOUD_MODELS=true,
# and the routing mode specialist_cloud_first. Otherwise everything stays on local models.

# Gemini (Google AI Studio). Default model: gemini-3.8-flash
QA_AI_GEMINI_API_KEY=

# Groq. Default model: openai/gpt-oss-120b
QA_AI_GROQ_API_KEY=

# OpenRouter (free cloud models; optional)
QA_AI_OPENROUTER_API_KEY=

QA_AI_ALLOW_CLOUD_MODELS=false
QA_AI_MODEL_ROUTING_MODE=local_first

# Optional model overrides
# QA_AI_GEMINI_MODEL=gemini-3.8-flash
# QA_AI_GROQ_MODEL=openai/gpt-oss-120b
# Tried when the main Gemini model is overloaded (503):
# QA_AI_GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
